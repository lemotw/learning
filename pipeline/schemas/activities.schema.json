{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning.local/schemas/activities.schema.json",
  "title": "Learning course activities manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "activities"],
  "properties": {
    "schema": { "const": 1 },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "resource", "unit", "kind", "title", "role", "required", "order"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "resource": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*:.+$" },
          "unit": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.md$" },
          "kind": { "enum": ["exercise", "lab", "reading", "drill", "project"] },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "role": { "enum": ["anchor", "practice", "extension"] },
          "required": { "type": "boolean" },
          "order": { "type": "integer", "minimum": 0 },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
